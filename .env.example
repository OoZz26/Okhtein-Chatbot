# Copy to .env and fill in your own values. Never commit .env.

# --- Runtime ---
ENVIRONMENT=development
# Load testing only (see docs/load-test-results.md): fake LLM + fake WhatsApp. REFUSED when ENVIRONMENT=production.
LOAD_TEST_MODE=false

# --- Store ---
STORE_URL=https://eg.okhtein.com
STORE_CURRENCY=EGP
PRODUCTS_PATH=data/products.json
KNOWLEDGE_PATH=data/knowledge.md

# --- LLM (OpenAI primary, OpenRouter fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# How hard the model thinks before answering (empty = the model's default). Less thinking = faster.
# gpt-5.4-mini: must be none (OpenAI rejects other values when tools are used on this API).
# gpt-5-mini: minimal | low | medium | high.
OPENAI_REASONING_EFFORT=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
# Providers to try, in order. Only providers with an API key set are used.
LLM_PROVIDER_ORDER=openai,openrouter
# Retries of a transient error (429, 5xx, timeout) per provider before moving to the next one.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
# Search rounds per reply before the model must answer (each round costs one AI call).
MAX_TOOL_ROUNDS=2
SEARCH_RESULT_LIMIT=5
# Which versioned prompt file to use: app/domain/agent/prompts/system_<version>.md
PROMPT_VERSION=v4
# Model that scores friendliness in the conversation evals (python -m tests.evals.run_conversations)
EVAL_JUDGE_MODEL=gpt-5-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
# How products are found: keyword | vector | hybrid (default). vector and hybrid fall back to keyword
# search if embeddings or pgvector are unavailable. Build the index with: python scripts/build_embeddings.py
RETRIEVER=hybrid

# --- Redis (short-term chat history) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Postgres (long-term history, profiles) ---
POSTGRES_HOST=localhost
# Host port. Use 5433 if a native Postgres already occupies 5432 (common on Windows).
POSTGRES_PORT=5432
POSTGRES_USER=okhtein
POSTGRES_PASSWORD=change-me
POSTGRES_DB=okhtein

# --- WAHA (WhatsApp gateway). Choose any long random string for the API key. ---
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Where WAHA (inside Docker) sends incoming messages; the bot runs on your host.
WAHA_WEBHOOK_URL=http://host.docker.internal:8000/webhook
# Shared secret WAHA uses to sign webhooks (HMAC-SHA512). Any long random string.
WAHA_WEBHOOK_HMAC_KEY=
WAHA_TIMEOUT_SECONDS=15

# --- Bot behaviour ---
SESSION_TTL_SECONDS=86400
HISTORY_LIMIT=20
# At most this many discovery questions (who for, occasion, type, colour/style, budget) before showing products.
MAX_DISCOVERY_QUESTIONS=5
DEBOUNCE_SECONDS=4
WEBHOOK_DEDUP_TTL_SECONDS=3600
# Wait this many seconds of quiet before answering a burst of messages (DEBOUNCE_SECONDS above).
# A chat's reply lock expires after LOCK_TTL_SECONDS; a waiting message gives up after LOCK_WAIT_SECONDS.
LOCK_TTL_SECONDS=120
LOCK_WAIT_SECONDS=90
# Human-like sending: at most MAX_BUBBLES messages per reply; typing pause = chars * SECONDS_PER_CHAR (capped).
MAX_BUBBLES=3
TYPING_SECONDS_PER_CHAR=0.03
TYPING_MAX_DELAY_SECONDS=3
# Global cap on outgoing WhatsApp messages per minute, shared by ALL chats (protects the number from
# looking like spam). One reply is up to MAX_BUBBLES texts + its product cards, so 60 ≈ 8-15 replies/min.
SEND_RATE_LIMIT_PER_MINUTE=60
# Human handoff: a handed-off chat goes back to the bot after this many hours of silence.
HANDOFF_TIMEOUT_HOURS=12
# Returning customers: how long the remembered summary may be, and how many shown products are remembered.
PROFILE_SUMMARY_MAX_CHARS=300
PROFILE_PRODUCTS_SHOWN_LIMIT=20
# Max seconds the first reply of a returning customer waits for the summary of their last visit.
PROFILE_SUMMARY_WAIT_SECONDS=3
# Optional: a WhatsApp number (digits, with country code) that is told when a customer needs a person.
# Leave empty to only log it. Only this one number is ever messaged.
STAFF_PHONE=
# Protects POST /admin/chats/{chat_id}/release. Any long random string; empty disables the endpoint.
ADMIN_API_KEY=
# Comma-separated phone numbers; if set the bot replies ONLY to these (use your test number).
ALLOWED_NUMBERS=
